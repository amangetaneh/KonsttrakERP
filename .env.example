# Copy to .env at the repository root. Values use POSIX shell quoting.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5067
ConnectionStrings__DefaultConnection='Server=localhost,1433;Database=erp_development;User Id=sa;Password=CHANGE_ME_DATABASE_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True'
# Generate a private signing key: openssl rand -hex 64
AppSettings__Token=CHANGE_ME_GENERATE_A_RANDOM_SIGNING_KEY
Cors__AllowedOrigins=http://localhost:5173
# Public, browser-visible URL. Never put credentials in VITE_* variables.
VITE_API_URL=http://localhost:5067/api/

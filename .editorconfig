root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = block_scoped:suggestion

[Makefile]
indent_style = tab

[*.sln]
end_of_line = lf
indent_style = tab

[ERP/Migrations/*.cs]
generated_code = true
